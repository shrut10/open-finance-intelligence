# Local runs are keyless and clearly labelled extractive by default.
OFI_LLM_ENABLED=false
OFI_LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
OFI_LLM_MODEL=
# Optional local provider key. Never commit real credentials.
OFI_LLM_API_KEY=
# Vercel deployments may use the automatically supplied VERCEL_OIDC_TOKEN.
